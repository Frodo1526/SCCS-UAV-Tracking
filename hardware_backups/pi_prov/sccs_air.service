[Unit]
Description=Service starts sccs-air python scripts, flight logging, etc on reboot
After=NetworkManager.service
Wants=NetworkManager.service
StartLimitIntervalSec=60 
StartLimitBurst=5

[Service]
Type=simple
User=capstone-pi
SupplementaryGroups=video dialout
WorkingDirectory=/home/capstone-pi/SCCS-UAV-Tracking/drone_air
Environment=PYTHONPATH=/home/capstone-pi/SCCS-UAV-Tracking
Environment=PYTHONUNBUFFERED=1 
ExecStart=/home/capstone-pi/<venv>/bin/python /home/capstone-pi/SCCS-UAV-Tracking/drone_air/air_boot.py
Restart=on-failure 
RestartSec=3
LogsDirectory=flight_logs
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
